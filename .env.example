# ===================================================
# GoldenStep AI V2.0 - Environment Config Example
# ===================================================

# 1. API Authentication
SEOUL_DATA_API_KEY=YOUR_SEOUL_API_KEY_HERE

# 2. Base Simulation Parameters
BASE_WALK_VELOCITY_KMH=2.4
FATIGUE_DECAY_LAMBDA=0.18
DEFAULT_SEARCH_RADIUS_M=3500.0
NUM_SIMULATION_AGENTS=2000

# 3. Graph & POI Data Paths
CACHE_GRAPH_PATH=/path/to/your/network_graph.graphml
BUILDING_POI_DATA_PATH=/path/to/your/building_pois.parquet
PUBLIC_POI_DATA_PATH=/path/to/your/public_pois.geojson
ELEVATION_SHAPEFILE_PATH=/path/to/your/elevation_data.shp

# 4. Benchmark Datasets (Train/Test)
V2_TRAIN_DATASET_PATH=/path/to/your/train_dataset.json
V3_TEST_DATASET_PATH=/path/to/your/test_dataset.json

# 5. Server Config
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=True